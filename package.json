{
  "dependencies": {
    "express": "^4.22.3",
    "mocha": "^12.0.3",
    "socket.io": "^4.8.4"
  },
  "scripts": {
    "start": "node server.js",
    "test": "mocha",
    "test:integration": "jest --runInBand",
    "test:e2e": "playwright test",
    "test:all": "mocha && jest --runInBand"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "jest": "^29.7.0",
    "snyk": "^1.1308.2",
    "socket.io-client": "^4.8.4"
  },
  "jest": {
    "testMatch": [
      "**/integration/**/*.test.js"
    ],
    "testTimeout": 10000
  },
  "overrides": {
    "proxy-addr": "2.0.8",
    "socket.io-parser": "4.2.7",
    "ws": "8.22.0"
  }
}
